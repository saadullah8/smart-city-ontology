        <rdfs:comment>Is Active is a datatype property used to store literal values in the Smart City ontology.</rdfs:comment>
        <rdfs:label>Is Active</rdfs:label>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#latitude -->

