    <!-- http://schema.org/containsPlace -->

    <ObjectProperty rdf:about="http://schema.org/containsPlace">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#isPlaceContainedIn"/>
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#SmartCity"/>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
        <rdfs:comment>Contains Place is an object property that links smart city ontology entities.</rdfs:comment>
        <rdfs:label>Contains Place</rdfs:label>
    </ObjectProperty>
    


    <!-- http://schema.org/memberOf -->

    <ObjectProperty rdf:about="http://schema.org/memberOf">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#hasMember"/>
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#CityResident"/>
