    <!-- https://smartcity-onto.org/ont#energyConsumption -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#energyConsumption">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartBuilding"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartGrid"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Energy Consumption is a datatype property used to store literal values in the Smart City ontology.</rdfs:comment>
        <rdfs:label>Energy Consumption</rdfs:label>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#installationDate -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#installationDate">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Installation Date is a datatype property used to store literal values in the Smart City ontology.</rdfs:comment>
        <rdfs:label>Installation Date</rdfs:label>
    </DatatypeProperty>
    


