<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:sc="https://smartcity-onto.org/ont#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="https://schema.org/"
     xmlns:dbpedia="http://dbpedia.org/ontology/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:schema1="http://schema.org/">
    <Ontology rdf:about="https://smartcity-onto.org/ont">
        <dc:creator>Smart City Ontology
Web Semantics Project - 6th Semester</dc:creator>
        <dc:title>Smart City Ontology</dc:title>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment>This ontology is released for educational use under the Creative Commons Attribution 4.0 International license.</rdfs:comment>
    </Ontology>
    


