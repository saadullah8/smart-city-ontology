    <!-- https://smartcity-onto.org/ont#SmartCity -->

    <Class rdf:about="https://smartcity-onto.org/ont#SmartCity">
        <rdfs:subClassOf rdf:resource="http://schema.org/Place"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://smartcity-onto.org/ont#managedBy"/>
                <someValuesFrom rdf:resource="https://smartcity-onto.org/ont#CityAuthority"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://smartcity-onto.org/ont#hasZone"/>
                <minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</minQualifiedCardinality>
                <onClass rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A city that uses digital technology and IoT to enhance performance and improve citizens quality of life.</rdfs:comment>
        <rdfs:label>Smart City</rdfs:label>
    </Class>
    


