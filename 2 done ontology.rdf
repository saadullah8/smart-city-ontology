    <!-- http://schema.org/description -->

    <DatatypeProperty rdf:about="http://schema.org/description">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartInfrastructure"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartService"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Description is a datatype property used to store literal values in the Smart City ontology.</rdfs:comment>
        <rdfs:label>Description</rdfs:label>
    </DatatypeProperty>
    


