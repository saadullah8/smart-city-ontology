        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Latitude is a datatype property used to store literal values in the Smart City ontology.</rdfs:comment>
        <rdfs:label>Latitude</rdfs:label>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#longitude -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#longitude">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#IoTDevice"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
