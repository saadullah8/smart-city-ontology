<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:sc="https://smartcity-onto.org/ont#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="https://schema.org/"
     xmlns:dbpedia="http://dbpedia.org/ontology/"
     xmlns:schema1="http://schema.org/">
    <Ontology rdf:about="https://smartcity-onto.org/ont">
        <dc:creator>Smart City Ontology
Web Semantics Project - 6th Semester</dc:creator>
        <dc:title>Smart City Ontology</dc:title>
    </Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->

    <AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://schema.org/containsPlace -->

    <ObjectProperty rdf:about="http://schema.org/containsPlace"/>
    


    <!-- http://schema.org/memberOf -->

    <ObjectProperty rdf:about="http://schema.org/memberOf"/>
    


    <!-- http://schema.org/provider -->

    <ObjectProperty rdf:about="http://schema.org/provider">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#CityAuthority"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#generatesData -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#generatesData">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#isDataFrom"/>
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#CityData"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#hasDevice -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#hasDevice">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#isDeviceOf"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartInfrastructure"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#hasInfrastructure -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#hasInfrastructure">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#isInfrastructureOf"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#SmartInfrastructure"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#hasResident -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#hasResident">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#residesIn"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#hasService -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#hasService">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#isServiceOf"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#hasZone -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#hasZone">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#isZoneOf"/>
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#SmartCity"/>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#isDataFrom -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#isDataFrom"/>
    


    <!-- https://smartcity-onto.org/ont#isDeviceOf -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#isDeviceOf"/>
    


    <!-- https://smartcity-onto.org/ont#isInfrastructureOf -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#isInfrastructureOf"/>
    


    <!-- https://smartcity-onto.org/ont#isServiceOf -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#isServiceOf"/>
    


    <!-- https://smartcity-onto.org/ont#isUsedBy -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#isUsedBy">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#usesService"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#isZoneOf -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#isZoneOf">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#SmartCity"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#managedBy -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#managedBy">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#manages"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartInfrastructure"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartService"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#CityAuthority"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#manages -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#manages"/>
    


    <!-- https://smartcity-onto.org/ont#monitoredBy -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#monitoredBy">
        <inverseOf rdf:resource="https://smartcity-onto.org/ont#monitors"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartInfrastructure"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#monitors -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#monitors"/>
    


    <!-- https://smartcity-onto.org/ont#residesIn -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#residesIn">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#CityResident"/>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
    </ObjectProperty>
    


    <!-- https://smartcity-onto.org/ont#usesService -->

    <ObjectProperty rdf:about="https://smartcity-onto.org/ont#usesService">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#CityResident"/>
        <rdfs:range rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
    </ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://schema.org/description -->

    <DatatypeProperty rdf:about="http://schema.org/description">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartInfrastructure"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartService"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- http://schema.org/email -->

    <DatatypeProperty rdf:about="http://schema.org/email">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#CityAuthority"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- http://schema.org/endDate -->

    <DatatypeProperty rdf:about="http://schema.org/endDate"/>
    


    <!-- http://schema.org/identifier -->

    <DatatypeProperty rdf:about="http://schema.org/identifier">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityResident"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#IoTDevice"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- http://schema.org/name -->

    <DatatypeProperty rdf:about="http://schema.org/name">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityAuthority"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartInfrastructure"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartService"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- http://schema.org/startDate -->

    <DatatypeProperty rdf:about="http://schema.org/startDate">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </DatatypeProperty>
    


    <!-- http://schema.org/telephone -->

    <DatatypeProperty rdf:about="http://schema.org/telephone">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#CityAuthority"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#airQualityIndex -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#airQualityIndex">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#EnvironmentData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#area -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#area">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#capacity -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#capacity">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#PublicTransportService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#energyConsumption -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#energyConsumption">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartBuilding"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartGrid"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#installationDate -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#installationDate">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#isActive -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#isActive">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#latitude -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#latitude">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#IoTDevice"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#longitude -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#longitude">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#IoTDevice"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#nationalID -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#nationalID">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#CityResident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#population -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#population">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#CityZone"/>
                    <rdf:Description rdf:about="https://smartcity-onto.org/ont#SmartCity"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#sensorType -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#sensorType">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- https://smartcity-onto.org/ont#trafficDensity -->

    <DatatypeProperty rdf:about="https://smartcity-onto.org/ont#trafficDensity">
        <rdfs:domain rdf:resource="https://smartcity-onto.org/ont#TrafficData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://dbpedia.org/ontology/Infrastructure -->

    <Class rdf:about="http://dbpedia.org/ontology/Infrastructure"/>
    


    <!-- http://dbpedia.org/ontology/PowerStation -->

    <Class rdf:about="http://dbpedia.org/ontology/PowerStation">
        <equivalentClass rdf:resource="https://smartcity-onto.org/ont#SmartGrid"/>
    </Class>
    


    <!-- http://schema.org/Dataset -->

    <Class rdf:about="http://schema.org/Dataset"/>
    


    <!-- http://schema.org/Event -->

    <Class rdf:about="http://schema.org/Event"/>
    


    <!-- http://schema.org/GovernmentOrganization -->

    <Class rdf:about="http://schema.org/GovernmentOrganization"/>
    


    <!-- http://schema.org/Organization -->

    <Class rdf:about="http://schema.org/Organization"/>
    


    <!-- http://schema.org/Person -->

    <Class rdf:about="http://schema.org/Person"/>
    


    <!-- http://schema.org/Place -->

    <Class rdf:about="http://schema.org/Place"/>
    


    <!-- http://schema.org/Report -->

    <Class rdf:about="http://schema.org/Report"/>
    


    <!-- http://schema.org/Service -->

    <Class rdf:about="http://schema.org/Service"/>
    


    <!-- http://schema.org/SoftwareApplication -->

    <Class rdf:about="http://schema.org/SoftwareApplication"/>
    


    <!-- http://schema.org/Vehicle -->

    <Class rdf:about="http://schema.org/Vehicle"/>
    


    <!-- https://smartcity-onto.org/ont#BusService -->

    <Class rdf:about="https://smartcity-onto.org/ont#BusService">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#PublicTransportService"/>
        <rdfs:label>Bus Service</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#Camera -->

    <Class rdf:about="https://smartcity-onto.org/ont#Camera">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
        <rdfs:label>Camera</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#CityAuthority -->

    <Class rdf:about="https://smartcity-onto.org/ont#CityAuthority">
        <rdfs:subClassOf rdf:resource="http://schema.org/GovernmentOrganization"/>
        <disjointWith rdf:resource="https://smartcity-onto.org/ont#CityResident"/>
        <rdfs:label>City Authority</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#CityData -->

    <Class rdf:about="https://smartcity-onto.org/ont#CityData">
        <disjointWith rdf:resource="https://smartcity-onto.org/ont#IoTDevice"/>
        <rdfs:label>City Data</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#CityResident -->

    <Class rdf:about="https://smartcity-onto.org/ont#CityResident">
        <rdfs:subClassOf rdf:resource="http://schema.org/Person"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://smartcity-onto.org/ont#residesIn"/>
                <someValuesFrom rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:label>City Resident</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#CityZone -->

    <Class rdf:about="https://smartcity-onto.org/ont#CityZone">
        <rdfs:comment>A designated area within a smart city with a specific purpose.</rdfs:comment>
        <rdfs:label>City Zone</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#CommercialZone -->

    <Class rdf:about="https://smartcity-onto.org/ont#CommercialZone">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
        <disjointWith rdf:resource="https://smartcity-onto.org/ont#ResidentialZone"/>
        <rdfs:label>Commercial Zone</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#EducationService -->

    <Class rdf:about="https://smartcity-onto.org/ont#EducationService">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
        <rdfs:label>Education Service</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#EnergyData -->

    <Class rdf:about="https://smartcity-onto.org/ont#EnergyData">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#CityData"/>
        <rdfs:label>Energy Data</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#EnvironmentData -->

    <Class rdf:about="https://smartcity-onto.org/ont#EnvironmentData">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#CityData"/>
        <rdfs:label>Environment Data</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#EnvironmentMonitoringService -->

    <Class rdf:about="https://smartcity-onto.org/ont#EnvironmentMonitoringService">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
        <rdfs:label>Environment Monitoring Service</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#GreenZone -->

    <Class rdf:about="https://smartcity-onto.org/ont#GreenZone">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
        <disjointWith rdf:resource="https://smartcity-onto.org/ont#IndustrialZone"/>
        <rdfs:label>Green Zone</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#HealthcareService -->

    <Class rdf:about="https://smartcity-onto.org/ont#HealthcareService">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
        <rdfs:label>Healthcare Service</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#IndustrialZone -->

    <Class rdf:about="https://smartcity-onto.org/ont#IndustrialZone">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
        <rdfs:label>Industrial Zone</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#IoTDevice -->

    <Class rdf:about="https://smartcity-onto.org/ont#IoTDevice">
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="https://smartcity-onto.org/ont#generatesData"/>
                <someValuesFrom rdf:resource="https://smartcity-onto.org/ont#CityData"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:label>IoT Device</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#MetroService -->

    <Class rdf:about="https://smartcity-onto.org/ont#MetroService">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#PublicTransportService"/>
        <rdfs:label>Metro Service</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#PublicTransportService -->

    <Class rdf:about="https://smartcity-onto.org/ont#PublicTransportService">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#SmartService"/>
        <rdfs:label>Public Transport Service</rdfs:label>
    </Class>
    


    <!-- https://smartcity-onto.org/ont#ResidentialZone -->

    <Class rdf:about="https://smartcity-onto.org/ont#ResidentialZone">
        <rdfs:subClassOf rdf:resource="https://smartcity-onto.org/ont#CityZone"/>
        <rdfs:label>Residential Zone</rdfs:label>
